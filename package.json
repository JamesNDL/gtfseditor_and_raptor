{
  "name": "gtfs-editor",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "feed:fetch": "node --env-file=.env packages/gtfs/src/cli/fetch.ts",
    "feed:audit": "node --env-file=.env packages/gtfs/src/feed/audit.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:backup": "node --env-file-if-exists=.env packages/gtfs/src/cli/backup.ts backup",
    "db:restore": "node --env-file-if-exists=.env packages/gtfs/src/cli/backup.ts restore",
    "import": "node --env-file=.env packages/gtfs/src/cli/import.ts",
    "test": "vitest run",
    "packs": "node --env-file=.env packages/gtfs/src/cli/packs.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @gtfs-editor/api\" \"npm run dev -w @gtfs-editor/web\"",
    "test:e2e": "node apps/api/test/scenarios.e2e.mjs",
    "test:e2e:fixture": "node apps/api/test/run-e2e-fixture.mjs",
    "test:import-replace": "node packages/gtfs/test/import-replace.e2e.mjs",
    "export:check": "node packages/gtfs/src/cli/export-check.ts",
    "test:ui": "node apps/web/test/ui-smoke.mjs",
    "test:access": "node apps/web/test/run-access-check.mjs",
    "test:sim": "node apps/api/test/sim.e2e.mjs",
    "test:roads": "node --env-file-if-exists=.env apps/api/test/roads.e2e.mjs",
    "router:build": "cd services/router && .\\gradlew build",
    "router:test": "cd services/router && .\\gradlew test",
    "router:load": "cd services/router && .\\gradlew -q :router-gtfs:loadTimetable",
    "router:route": "cd services/router && .\\gradlew -q :router-gtfs:route",
    "router:compare": "node services/router/tools/compare-tfnsw.mjs",
    "router:dev": "cd services/router && .\\gradlew :router-server:run",
    "router:road": "cd services/router && .\\gradlew :router-server:runRoad",
    "router:demand": "cd services/router && .\\gradlew -q :router-sim:demand",
    "router:simulate": "cd services/router && .\\gradlew -q :router-sim:simulate",
    "router:bench": "cd services/router && .\\gradlew :router-bench:jmh",
    "router:road-import": "cd services/router && .\\gradlew :router-road:roadImport",
    "road:data": "node packages/gtfs/src/cli/road-data.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
