{
  "name": "gtfs-editor",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "feed:fetch": "node --env-file=.env packages/gtfs/src/fetch-cli.ts",
    "feed:audit": "node --env-file=.env packages/gtfs/src/audit.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "import": "node --env-file=.env packages/gtfs/src/import-cli.ts",
    "test": "vitest run",
    "packs": "node --env-file=.env packages/gtfs/src/packs-cli.ts",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @gtfs-editor/api\" \"npm run dev -w @gtfs-editor/web\"",
    "test:e2e": "node apps/api/test/scenarios.e2e.mjs",
    "export:check": "node packages/gtfs/src/export-check.ts",
    "test:ui": "node apps/web/test/ui-smoke.mjs",
    "test:sim": "node apps/api/test/sim.e2e.mjs",
    "router:build": "cd services/router && .\\gradlew build",
    "router:test": "cd services/router && .\\gradlew test",
    "router:load": "cd services/router && .\\gradlew -q :router-gtfs:loadTimetable",
    "router:route": "cd services/router && .\\gradlew -q :router-gtfs:route",
    "router:compare": "node services/router/tools/compare-tfnsw.mjs",
    "router:dev": "cd services/router && .\\gradlew :router-server:run",
    "router:demand": "cd services/router && .\\gradlew -q :router-sim:demand",
    "router:simulate": "cd services/router && .\\gradlew -q :router-sim:simulate",
    "router:bench": "cd services/router && .\\gradlew :router-bench:jmh",
    "router:road-import": "cd services/router && .\\gradlew :router-road:roadImport"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
