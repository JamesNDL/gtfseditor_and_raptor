# TfNSW Open Data Hub API key (https://opendata.transport.nsw.gov.au)
API_KEY=

# Optional: the road router, used to make new bus lines follow roads. This is the road side of our
# journey router (services/router, `npm run router:dev`), which answers the OSRM route, table and
# nearest requests the editor sends; or the road-only process on 3003 (`npm run router:road`) if
# memory is short. It needs road data: `npm run road:data`. Nothing is sent off this machine.
# Without it, new bus lines follow existing bus routes where they already run, and are straight elsewhere.
# Check it with `npm run test:roads`.
ROUTER_URL=http://localhost:3002

# Optional: the public transport side of the same journey router, which also runs the passenger
# simulator. Start it with `npm run router:dev`.
# ROUTER_SERVICE_URL=http://localhost:3002
# Where that service can reach this API, to fetch an export.
# API_PUBLIC_URL=http://localhost:3001
# Set to 0 if the router runs on another machine and cannot read data/sim/demand from this one.
# ROUTER_SHARES_FILES=1
