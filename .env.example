# TfNSW Open Data Hub API key (https://opendata.transport.nsw.gov.au)
API_KEY=

# Optional: a road routing server that speaks the OSRM route API, used to make new bus lines follow roads.
# Without it, new bus lines follow existing bus routes where they already run, and are straight elsewhere.
# The public demo server is fine for trying it out (stop coordinates are sent to it); host your own for real use.
# ROUTER_URL=https://router.project-osrm.org

# Optional: the journey router service (services/router), which also runs the passenger simulator.
# This is a different thing from ROUTER_URL above. Start it with `npm run router:dev`.
# ROUTER_SERVICE_URL=http://localhost:3002
# Where that service can reach this API, to fetch an export.
# API_PUBLIC_URL=http://localhost:3001
# Set to 0 if the router runs on another machine and cannot read data/sim/demand from this one.
# ROUTER_SHARES_FILES=1
